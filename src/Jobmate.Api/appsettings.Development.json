{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Development-only demonstration data: three employers, four workers, jobs in several
  // states, a completed booking with a settled payment, a conversation, and rows waiting
  // in the admin queues.
  //
  // DemoDataSeeder additionally requires the host to be running as Development, so
  // switching this on by accident in another environment still does nothing.
  //
  // The password lives here rather than in a user-secret because this file is only ever
  // loaded in Development and exists to make a fresh clone work with no setup. Every
  // demo account shares it and every one of them ends in @demo.jobmate.test, so there is
  // nothing here worth protecting. It is not a real credential and the accounts it opens
  // are not real people.
  "Seed": {
    "DemoData": true,
    "DemoPassword": "DemoPassw0rd!2026"
  },

  // Abuse guards. The values here are the defaults in RateLimitOptions; they are listed
  // so a deployment can see what it is running and change it in one place.
  "RateLimit": {
    "AuthPermitLimit": 10,
    "AuthWindow": "00:01:00",
    "MessagingPermitLimit": 30,
    "MessagingWindow": "00:01:00",
    "MediaPermitLimit": 10,
    "MediaWindow": "00:01:00",
    "ReportsPermitLimit": 5,
    "ReportsWindow": "01:00:00",
    "VerificationPermitLimit": 10,
    "VerificationWindow": "01:00:00"
  }
}
